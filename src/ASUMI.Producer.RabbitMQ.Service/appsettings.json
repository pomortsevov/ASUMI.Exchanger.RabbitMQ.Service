{
  "AsumiProducerRabbitMq": {
    "Enabled": true,
    "IntervalSeconds": 5
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "rmuser",
    "Password": "rmpassword",
    "ExchangeName": "asumi.exchange",
    "QueueName": "asumi.queue",
    "RoutingKey": "asumi.json",
    "MessageTtlMs": 30000,
    "Persistent": true,
    "AutomaticRecovery": true,
    "NetworkRecoveryIntervalSeconds": 10,
    "ConnectionName": "ASUMI.Producer.RabbitMQ.Service"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}