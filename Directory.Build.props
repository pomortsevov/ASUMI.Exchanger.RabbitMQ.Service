<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Company>ASUMI</Company>
    <Product>ASUMI.Producer.RabbitMQ.Service</Product>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <!--
    TreatWarningsAsErrors - warnings as errors, with exceptions for categories
    that should not break the whole solution build:
      NU1901-NU1904 - vulnerabilities in transitive packages
      NU1605        - package downgrade (Microsoft.Extensions.* version conflict)
      CS8034        - analyzer could not be loaded (usually temporary VS glitch)
      CA1305        - culture-dependent formatting
      CA1848        - prefer LoggerMessage delegates over ILogger extensions
      CA1513        - prefer ObjectDisposedException.ThrowIf
      CA1873        - do not evaluate expensive arguments if logging is disabled
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904;NU1605;CS8034;CA1305;CA1848;CA1513;CA1873</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" Condition="!Exists('packages.config')">
      <PrivateAssets>all</PrivateAssets>
      <Version>3.10.94</Version>
    </PackageReference>
  </ItemGroup>
</Project>